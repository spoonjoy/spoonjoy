{
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "web",
      "packages/*"
    ]
  },
  "scripts": {
    "ci:build": "yarn rw test && yarn rw build",
    "ci:migrate": "DATABASE_URL=$MIGRATE_DATABASE yarn rw deploy vercel --no-build"
  },
  "devDependencies": {
    "@redwoodjs/core": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.1.13"
  },
  "eslintConfig": {
    "extends": "@redwoodjs/eslint-config",
    "root": true
  },
  "engines": {
    "node": ">=14.19 <=16.x",
    "yarn": ">=1.15"
  },
  "prisma": {
    "seed": "yarn rw exec seed"
  },
  "packageManager": "yarn@3.2.4",
  "resolutions": {
    "@hookform/devtools@^4.2.2": "patch:@hookform/devtools@npm%3A4.2.2#./.yarn/patches/@hookform-devtools-npm-4.2.2-aafab2382b.patch",
    "@redwoodjs/api@^3.2.0": "patch:@redwoodjs/api@npm%3A3.2.0#./.yarn/patches/@redwoodjs-api-npm-3.2.0-48e80d9986.patch",
    "@redwoodjs/api@3.2.0": "patch:@redwoodjs/api@npm%3A3.2.0#./.yarn/patches/@redwoodjs-api-npm-3.2.0-48e80d9986.patch"
  }
}
