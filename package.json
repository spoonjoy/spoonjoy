{
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "web",
      "packages/*"
    ]
  },
  "devDependencies": {
    "@redwoodjs/auth-dbauth-setup": "4.2.0",
    "@redwoodjs/core": "4.2.0",
    "graphql-2-json-schema": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.1.13"
  },
  "eslintConfig": {
