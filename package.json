{
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "web",
      "packages/*"
    ]
  },
  "devDependencies": {
    "@redwoodjs/auth-dbauth-setup": "8.2.0",
    "@redwoodjs/core": "8.2.0",
    "clipboardy": "^2.3.0",
    "graphql-2-json-schema": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.1.13"
  },
  "eslintConfig": {
    "extends": "@redwoodjs/eslint-config",
    "root": true
  },
  "engines": {
    "node": "=20.x"
  },
  "prisma": {
    "seed": "yarn rw exec seed"
  },
  "scripts": {
    "cap": "yarn workspace web run -- cap",
    "cap:bso": "yarn rw build web && yarn cap sync && yarn cap open ios"
  },
  "packageManager": "yarn@4.4.0",
  "resolutions": {
    "@hookform/devtools@^4.2.2": "patch:@hookform/devtools@npm%3A4.2.2#./.yarn/patches/@hookform-devtools-npm-4.2.2-aafab2382b.patch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.279.0",
    "@types/html-minifier": "^4.0.2",
    "@types/pluralize": "^0.0.29",
    "api": "workspace:^",
    "jsdom": "^21.1.1",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "mitt": "^3.0.0",
    "pluralize": "^8.0.0",
    "puppeteer-core": "19.7.0",
    "schema-dts": "^1.1.0"
  }
}
