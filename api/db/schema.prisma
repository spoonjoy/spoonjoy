datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

// Define your own datamodels here and run `yarn redwood prisma migrate dev`
// to create migrations for them and apply to your dev DB.

model User {
  id                  String  @id @default(cuid())
  email               String  @unique
  username            String  @unique
  hashedPassword      String
  salt                String
  resetToken          String?
  resetTokenExpiresAt DateTime?
  webAuthnChallenge   String? @unique
  credentials         UserCredential[]
  createdAt           DateTime  @default(now())
  recipes             Recipe[]
  shoppingList        ShoppingList?
}

model UserCredential {
  id         String  @id
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  publicKey  Bytes
  transports String?
  counter    BigInt
}

model Recipe {
  id                  String  @id @default(cuid())
  title               String
  description         String?
  servings            Int?
  chefId              String
  chef                User      @relation(fields: [chefId], references: [id])
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?
  steps               RecipeStep[]

  @@unique([chefId, title])
}

model RecipeStep {
  id                String  @id @default(cuid())
  recipeId          String
  recipe            Recipe  @relation(fields: [recipeId], references: [id])
  stepNum           Int
  description       String?
  ingredients       Ingredient[]

  @@unique([recipeId, stepNum])
}

model Ingredient {
  id                String        @id @default(cuid())
  recipeStepId      String
  recipeStep        RecipeStep    @relation(fields: [recipeStepId], references: [id], onDelete: Cascade)
  quantity          Float
  unitId            String
  unit              Unit          @relation(fields: [unitId], references: [id])
  ingredientRefId   String
  ingredientRef     IngredientRef @relation(fields: [ingredientRefId], references: [id])

  @@unique([recipeStepId, unitId, ingredientRefId])
}

model IngredientRef {
  id                String  @id @default(cuid())
  name              String  @unique
  ingredients       Ingredient[]
  shoppingListIems  ShoppingListItem[]
}

model Unit {
  id                String  @id @default(cuid())
  name              String  @unique
  ingredients       Ingredient[]
  shoppingListIems  ShoppingListItem[]
}

model ShoppingList {
  id          String  @id @default(cuid())
  authorId    String  @unique
  author      User    @relation(fields: [authorId], references: [id])
  items       ShoppingListItem[]
}

model ShoppingListItem {
  id                String        @id @default(cuid())
  shoppingListId    String
  shoppingList      ShoppingList  @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  quantity          Float
  unitId            String
  unit              Unit          @relation(fields: [unitId], references: [id])
  ingredientRefId   String
  ingredientRef     IngredientRef @relation(fields: [ingredientRefId], references: [id])

  @@unique([shoppingListId, unitId, ingredientRefId])
}
